# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Only needed if the React app is served from another domain (production)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Supabase (Project Settings -> API) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# --- Free LLM (any OpenAI-compatible API) ---
# Option A: Groq        -> https://api.groq.com/openai/v1
# Option B: OpenRouter  -> https://openrouter.ai/api/v1   (pick a model ending in :free)
# Option C: Gemini      -> https://generativelanguage.googleapis.com/v1beta/openai/
# Check the provider's current free model names before choosing LLM_MODEL.
OPENAI_API_KEY=your-free-api-key
OPENAI_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.1-8b-instant

# Optional: change the bot's behaviour
SYSTEM_PROMPT=You are a friendly, concise assistant. Answer in the user's language.
